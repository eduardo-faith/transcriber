# ElevenLabs API-Key (Pflicht) – https://elevenlabs.io  Profil -> API Keys
ELEVENLABS_API_KEY=

# Ablageverzeichnis für Datenbank, Uploads und Ergebnisse
DATA_DIR=/srv/transcriber

# Netzwerk (nur LAN -> keine Authentifizierung)
HOST=0.0.0.0
PORT=8000

# Speech-to-Text-Modell
STT_MODEL=scribe_v2

# Standard-Sprache (ISO-639-3). Leer oder "auto" = automatische Erkennung
DEFAULT_LANGUAGE=deu

# Audiodatei nach erfolgreicher Transkription löschen (true/false)
DELETE_AUDIO_AFTER=true

# Gleichzeitig laufende Transkriptions-Jobs
MAX_CONCURRENCY=2

# Maximale Uploadgröße in MB
MAX_UPLOAD_MB=1024

# Timeout für die ElevenLabs-Anfrage in Sekunden (lange Dateien!)
REQUEST_TIMEOUT=1800
